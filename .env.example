# Copiar a .env y llenar los valores. El .env NO se sube a Git.
# Lo lee el rag-service al arrancar (spring.config.import).
# No dejar vacía una variable que tiene valor por defecto: un valor vacío le gana al defecto.

# Réplica de solo lectura (la clave es DB_LECTURA_PASSWORD de oficina-agua-infra/.env)
RAG_REPLICA_PASSWORD=

# Historial del chat en DynamoDB Local. Sin esto se intenta usar AWS real.
DYNAMODB_ENDPOINT=http://localhost:8010
AWS_REGION=us-east-1

# Ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3